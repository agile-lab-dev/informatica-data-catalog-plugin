# Copy this file to .env for local development. Do not commit .env.
# Load it before starting the plugin: set -a; source .env; set +a

# Local HTTP port
SERVER_PORT=8888

# Informatica service account. Keep these values in a secret manager outside local development.
INFORMATICA_DCMP_USERNAME=
INFORMATICA_DCMP_PASSWORD=

# IDMC regional endpoints. Leave unset to use the European defaults.
INFORMATICA_BASE_URL=
INFORMATICA_MP_BASE_URL=
INFORMATICA_MP_WRAPPER_BASE_URL=
INFORMATICA_DC_BASE_URL=
INFORMATICA_DC_UI_BASE_URL=

# Publication controls
INFORMATICA_PUBLISH_ALLOWED_ENV=
INFORMATICA_MP_CATEGORY_VALIDATION_ENABLED=true

# Data Catalog controls
INFORMATICA_DC_ENABLE_METADATA_SYNC=true
INFORMATICA_DC_VALIDATION_LEVEL=LOW

# Example Catalog source mapping. Configure the technology mapping in
# src/main/resources/application.yml for each technology used by the tenant.
INFORMATICA_DC_EXAMPLE_TECHNOLOGY_CATALOG_SRC=
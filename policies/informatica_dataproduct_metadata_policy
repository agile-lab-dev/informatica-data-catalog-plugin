import "strings"

#CertifiedUse:     "Generic" | "Analysis" | "AI Model" | "Regoletory"
#DataProductType:  "Source-aligned" | "Aggregated" | "Consumer-aligned"
#LifeCycleStatus:  "Draft" | "Proposed" | "In Development" | "Active" | "Retired" | "Deprecated"
#SensitiveInfo:    "Si" | "No"
#Confidentiality:  "Public" | "Private" | "Reserved"
#MemorizationType: "Si" | "No" | "In identification"

// Data product root
id!:                          string & strings.MinRunes(1)
name!:                        string & strings.MinRunes(1)
description!:                 string & strings.MinRunes(1)
dataProductOwnerDisplayName!: string & strings.MinRunes(1)
version!:                     string & strings.MinRunes(1)

specific!: {

	// Mandatory (@NotNull)
	technicalOwners!:    string & strings.MinRunes(1)
	company!:            string & strings.MinRunes(1)
	businessDomain!:     string & strings.MinRunes(1)
	businessSubdomain!:  string & strings.MinRunes(1)
	creationDate!:       string & strings.MinRunes(1)

	// Mandatory + closed vocabulary (@NotNull + @Pattern)
	dataProductType!: #DataProductType
	lifeCycleStatus!: #LifeCycleStatus
	sensitiveInfo!:   #SensitiveInfo

	// Optional, but if present must match the closed vocabulary
	// (the mapper applies a default when absent, so @NotNull never trips)
	certifiedUse?:     #CertifiedUse
	confidentiality?:  #Confidentiality
	memorizationType?: #MemorizationType

	...
}

...
